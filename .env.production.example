# =============================================================================
# RoadCruise — Production environment template
# =============================================================================
# Copy to `.env` (or load into your host's secret manager) and fill the values
# marked <FILL>. Non-secret branding is pre-filled from the client checklist.
#
# SECURITY: never commit the real .env. Secrets (API keys, salt keys, tokens)
# belong in a secret manager, not in version control.
# =============================================================================

NODE_ENV=production

# ---- Business branding (appears in every customer message) ------------------
# Client: "CAR RENTALS AND TOURS | ROADCRUISE". These are NOT secrets.
COMPANY_NAME=RoadCruise Car Rentals & Tours
SUPPORT_PHONE=+91 73388 99062          # secondary: +91 73388 99063
SUPPORT_EMAIL=info@roadcruise.in
COMPANY_URL=https://roadcruise.in
COMPANY_LOGO_URL=                       # <FILL> public https URL to the logo (client to provide file)

# Admin alerts: a WhatsApp ping to the business for every booking (paid/unpaid).
ADMIN_NAME=Karthik
ADMIN_WHATSAPP=+917338899062

# =============================================================================
# Notification engine
# =============================================================================
NOTIF_ENABLED=true
NOTIF_EMAIL_ENABLED=true
NOTIF_SMS_ENABLED=true
NOTIF_WHATSAPP_ENABLED=true

# REQUIRED in production — without it the admin API returns 503 (fail closed).
NOTIF_ADMIN_TOKEN=<FILL: a long random secret>

# Dead-letter alerting (ops inbox for failed messages).
NOTIF_DLQ_ALERT_ENABLED=true
NOTIF_DLQ_ALERT_EMAIL=info@roadcruise.in

# ---- Email: SMTP (Brevo / SES / Postmark / any relay) -----------------------
# Requires a verified sending domain with SPF + DKIM (see CLIENT_SETUP_GUIDE.md).
NOTIF_EMAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<FILL: relay login>
SMTP_PASS=<FILL: relay SMTP key>
SMTP_FROM=RoadCruise <no-reply@roadcruise.in>
SMTP_REQUIRE_TLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true

# ---- SMS: MSG91 (India, DLT-compliant) --------------------------------------
# Client SMS number on file: 7338899062. Requires DLT registration + approved
# template (see CLIENT_SETUP_GUIDE.md).
NOTIF_SMS_PROVIDER=msg91
MSG91_API_KEY=<FILL: MSG91 auth key>
MSG91_SENDER_ID=<FILL: 6-char DLT header, e.g. RDCRUS>
MSG91_TEMPLATE_ID=<FILL: approved DLT flow template id>
MSG91_DEFAULT_COUNTRY_CODE=91

# ---- WhatsApp: Meta Cloud API -----------------------------------------------
# Client WhatsApp number on file: 7338899062. Requires Meta business
# verification + approved templates (see CLIENT_SETUP_GUIDE.md).
NOTIF_WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=<FILL: Meta phone number id>
WHATSAPP_ACCESS_TOKEN=<FILL: permanent System User token>
WHATSAPP_API_VERSION=v21.0

# =============================================================================
# Payments — PhonePe (client's chosen gateway)
# =============================================================================
PAYMENTS_ENABLED=true
PAYMENT_WEBHOOK_ENABLED=true
PAYMENT_PROVIDER=phonepe
PAYMENT_CURRENCY=INR

# PhonePe salt-based PG API credentials (from the PhonePe Business dashboard).
PHONEPE_MERCHANT_ID=<FILL: merchant id>
PHONEPE_SALT_KEY=<FILL: salt key>          # SECRET
PHONEPE_SALT_INDEX=1
# Prod host below; UAT/sandbox is https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_BASE_URL=https://api.phonepe.com/apis/hermes
# Where PhonePe returns the customer's browser after payment. {orderId} is
# substituted by the gateway; point it at this backend's return endpoint.
PHONEPE_REDIRECT_URL=https://api.roadcruise.in/api/payments/phonepe/return?orderId={orderId}
# Server-to-server callback PhonePe POSTs the signed result to.
PHONEPE_CALLBACK_URL=https://api.roadcruise.in/api/payments/phonepe/callback
# Frontend result page the customer is finally sent to (?status=&orderId= appended).
PHONEPE_RESULT_URL=https://roadcruise.in/payment-status

# =============================================================================
# Scale-out substrates (optional — JSON/in-process defaults work for a single node)
# =============================================================================
# REDIS_URL=redis://<host>:6379
# DATABASE_URL=postgres://<user>:<pass>@<host>:5432/roadcruise
