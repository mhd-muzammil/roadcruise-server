# ============================================================================
#  Road Cruise — Server environment template. Copy to .env and fill as needed.
#  The notification module runs with ZERO config (mock providers, JSON store,
#  in-process queue). Everything below is optional and only needed to go live.
# ============================================================================

# Existing
PORT=5000

# ---- Notification engine: master + per-channel feature flags ----
NOTIF_ENABLED=true
NOTIF_EMAIL_ENABLED=true
NOTIF_SMS_ENABLED=true
NOTIF_WHATSAPP_ENABLED=true

# ---- Provider selection (mock = default, no creds required) ----
# email: mock | smtp     sms: mock | twilio | msg91 | airtel     whatsapp: mock | meta
# Production go-live: NOTIF_EMAIL_PROVIDER=smtp (Brevo), NOTIF_SMS_PROVIDER=msg91,
# NOTIF_WHATSAPP_PROVIDER=meta. Flip one channel at a time; no code changes needed.
NOTIF_EMAIL_PROVIDER=mock
NOTIF_SMS_PROVIDER=mock
NOTIF_WHATSAPP_PROVIDER=mock

# ---- Substrate (leave unset for zero-infra JSON + in-process queue) ----
# REDIS_URL=redis://localhost:6379          # enables BullMQ queue
# DATABASE_URL=postgres://user:pass@host/db # enables Postgres repository (when implemented)

# ---- Retry / backoff policy ----
NOTIF_MAX_ATTEMPTS=3
NOTIF_BACKOFF_MS=2000
NOTIF_BACKOFF_FACTOR=3
NOTIF_MAX_BACKOFF_MS=60000
NOTIF_BACKOFF_JITTER_MS=500
NOTIF_CONCURRENCY=4

# ---- Branding (used in templates) ----
COMPANY_NAME=Road Cruise
SUPPORT_PHONE=+91 99999 99999
SUPPORT_EMAIL=support@roadcruise.com
COMPANY_URL=https://roadcruise.example
COMPANY_LOGO_URL=

# ---- Admin API protection (REQUIRED in production) ----
# Send this value as the `x-admin-token` header to /api/notifications/*
NOTIF_ADMIN_TOKEN=

# ---- Admin booking alerts (Email + WhatsApp to the business on every booking) ----
# Staff get an admin-POV Email + WhatsApp for each booking (paid & unpaid) with
# the customer's details. ADMIN_EMAIL falls back to SUPPORT_EMAIL, ADMIN_WHATSAPP
# to SUPPORT_PHONE. An unset channel address is silently skipped (never fails).
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_WHATSAPP=

# ---- Dead-letter admin alerts ----
NOTIF_DLQ_ALERT_ENABLED=true
NOTIF_DLQ_ALERT_EMAIL=

# ---- SMTP / Brevo (NOTIF_EMAIL_PROVIDER=smtp) ----
# Brevo: SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_SECURE=false
#        SMTP_USER=<brevo login>  SMTP_PASS=<brevo SMTP key>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false                 # true => implicit TLS (port 465)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@roadcruise.com
# Connection pooling + rate limiting + timeouts (optional; safe defaults shown)
SMTP_POOL=true
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100
SMTP_RATE_LIMIT=0                 # messages per SMTP_RATE_DELTA_MS window (0 = unlimited)
SMTP_RATE_DELTA_MS=1000
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
SMTP_REQUIRE_TLS=true             # force STARTTLS on non-secure ports
SMTP_TLS_REJECT_UNAUTHORIZED=true # verify cert chain — keep true in production

# ---- Twilio SMS (NOTIF_SMS_PROVIDER=twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# ---- MSG91 SMS (NOTIF_SMS_PROVIDER=msg91) — India DLT-compliant, v5 Flow API ----
# MSG91 holds the DLT-APPROVED content; we send a template id + variable values
# and MSG91 renders it. Nothing else is ever transmitted, which is what keeps the
# delivered text identical to what the operators approved.
#
# NOTE: these template ids are MSG91's own 24-char hex ids (MSG91 panel ->
# Templates), NOT the 19-digit Airtel DLT ids in the DLT_TID_* block below. The
# two are different identifiers and are not interchangeable.
MSG91_API_KEY=                    # MSG91 AuthKey — SERVER ONLY, never expose to the client
MSG91_SENDER_ID=KVROCR            # Airtel-approved 6-char header (DLT id 1005649179413990895)
MSG91_DEFAULT_COUNTRY_CODE=91     # prepended to bare 10-digit numbers
MSG91_BASE_URL=https://control.msg91.com
MSG91_TIMEOUT_MS=15000

# Per-event MSG91 template ids. An event whose id is blank FAILS SAFE — it
# dead-letters instead of sending unapproved content. Run `npm run msg91:templates`
# to see the live mapping and what is still missing.
MSG91_OTP_TEMPLATE_ID=6a7359294976ac1599096612       # OTP_VERIFICATION      (DLT 1077512810022246340) Verified by DLT — but BLOCKED, see below
MSG91_REMINDER_TEMPLATE_ID=6a735a25ab93306df0082913  # REMINDER_BEFORE_RIDE  (DLT 1077340200023002579) Verified by DLT
MSG91_BOOKING_TEMPLATE_ID=                           # BOOKING_CONFIRMATION  (DLT 1077397880030911933) approved on Airtel DLT, NOT YET created in MSG91

# Variable-name overrides, only needed when the ##names## in the MSG91 template
# differ from the defaults in config/msg91Templates.js. Format, in template
# order: <msg91 variable name>=<notification context key>
# !! OTP IS CURRENTLY BLOCKED — IT WILL DEAD-LETTER, NOT SEND !!
# The MSG91 OTP template content is, verbatim from the panel:
#   ##alphanumeric## is your One-Time Password (OTP) ##numeric##to verify your
#   account with RoadCruise. Valid for 5 minutes. Do not share this code with
#   anyone. - ##alphanumeric##
# Two defects make every possible mapping wrong: ##alphanumeric## appears twice
# under ONE name (so the code and the trailing signature can never differ), and
# ##numeric## sits mid-sentence with no trailing space (any value renders
# "...(OTP) 5to verify..."). Shipping a wrong mapping would deliver malformed
# OTPs, so the provider refuses to send until this is resolved.
#
# TO UNBLOCK (no deploy): fix the template in the MSG91 panel so it matches the
# DLT-approved text with two DISTINCTLY named variables, then set the real names:
#MSG91_OTP_VARS=otp=otp,company=companyName
#MSG91_REMINDER_VARS=bookingId=bookingId,tripDate=tripDate,vehicle=vehicle,pickup=pickup,driver=driver
#MSG91_BOOKING_VARS=bookingId=bookingId,vehicle=vehicle,tripDate=tripDate,driver=driver,paymentAmount=paymentAmount

# ============================================================================
#  INDIA DLT (TRAI) — REQUIRED FOR ALL SMS TO INDIAN NUMBERS
# ============================================================================
#  Every commercial SMS in India must match a CONTENT TEMPLATE pre-registered on
#  a DLT portal (RoadCruise registered on Airtel's, one-time fee). The approved
#  ids below travel with each send; an unregistered body is accepted with a 200
#  and then DROPPED by the operator — so this is not optional plumbing.
#
#  DLT ids are issued by the operator chain, not by the sender, so the SAME ids
#  work through Airtel IQ, MSG91, or any other aggregator. Registering once
#  covers every operator (Jio/Airtel/Vi/BSNL).
#
#  Workflow:
#    1. Set COMPANY_NAME + SUPPORT_PHONE above FIRST — they are baked into every
#       registered template as FIXED text. Registering with a «CHANGEME»
#       placeholder means re-registering all ~19 templates.
#    2. npm run dlt:templates          -> the exact text to paste into the portal
#    3. Register each template, wait for APPROVED (a few hours to ~2 days)
#    4. npm run dlt:templates -- --env -> paste the block here, fill in the ids
#    5. Flip NOTIF_SMS_PROVIDER to airtel (or msg91)
#
#  Re-run `npm run dlt:templates` after ANY edit to an SMS template: the
#  transmitted text must match the registered text character-for-character.
# ============================================================================

# 19-digit Principal Entity ID (PE ID) from the DLT portal.
DLT_ENTITY_ID=
# Approved 6-character Header / sender id, e.g. RDCRSE.
DLT_HEADER_ID=

# Approved 19-digit Content Template ids, one per event. Generate this whole
# block with: npm run dlt:templates -- --env
# Any event left blank DEAD-LETTERS instead of sending (deliberate: a silent
# operator drop is far harder to notice than a failed job).
DLT_TID_BOOKING_CREATED=
DLT_TID_BOOKING_CONFIRMED=
DLT_TID_BOOKING_CANCELLED=
DLT_TID_BOOKING_RESCHEDULED=
DLT_TID_PAYMENT_SUCCESSFUL=
DLT_TID_PAYMENT_FAILED=
DLT_TID_PAYMENT_PENDING=
DLT_TID_REFUND_INITIATED=
DLT_TID_REFUND_COMPLETED=
DLT_TID_TRIP_SCHEDULED=
DLT_TID_TRIP_REMINDER=
DLT_TID_TRIP_STARTED=
DLT_TID_TRIP_COMPLETED=
DLT_TID_DRIVER_ASSIGNED=
DLT_TID_DRIVER_CHANGED=
DLT_TID_INVOICE_GENERATED=
DLT_TID_CUSTOMER_REGISTERED=
DLT_TID_OTP_REQUESTED=
DLT_TID_PASSWORD_RESET=

# ---- Airtel IQ SMS (NOTIF_SMS_PROVIDER=airtel) ----
# Credentials come from the Airtel IQ CONSOLE — they are NOT the DLT portal
# login, and the DLT registration fee does not include Airtel IQ credits.
AIRTEL_IQ_CUSTOMER_ID=
AIRTEL_IQ_USERNAME=
AIRTEL_IQ_PASSWORD=
AIRTEL_IQ_SENDER_ID=              # approved 6-char header; falls back to DLT_HEADER_ID
AIRTEL_IQ_BASE_URL=https://iqsms.airtel.in
# SERVICE_IMPLICIT = transactional/service msgs to your own customers (bypasses
# DND). Use PROMOTIONAL only for marketing, which DND-scrubs.
AIRTEL_IQ_MESSAGE_TYPE=SERVICE_IMPLICIT
AIRTEL_IQ_DEFAULT_COUNTRY_CODE=91
AIRTEL_IQ_TIMEOUT_MS=15000

# ---- Meta WhatsApp Cloud API (NOTIF_WHATSAPP_PROVIDER=meta) ----
# Primary (mission) names; META_WHATSAPP_* still honored for back-compat.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TIMEOUT_MS=15000

# ============================================================================
#  PLACE SEARCH (trip-planner autocomplete). Works with NO key — it falls back
#  to keyless OpenStreetMap (Photon + Nominatim). But OSM's Indian POI coverage
#  is thin and its pincodes are often wrong (it tags Mannivakkam 603211; India
#  Post says 600048), so set an Ola Maps key for production-grade results.
#
#  Get one free at https://maps.olakrutrim.com — 500,000 requests/month across
#  all APIs, which at ~12 requests per booking search is ~40k searches/month.
#  Leave BLANK to stay on OpenStreetMap.
#
#  Paste the key raw and unquoted. Never let it contain "#": dotenv truncates
#  unquoted values at "#" and you would silently ship a half key (a rejected
#  key logs "[places] ola search failed ... 401: Unauthorized" and falls back
#  to OSM, so search keeps working and the misconfiguration is easy to miss).
# ============================================================================
OLA_MAPS_API_KEY=

# ============================================================================
#  PAYMENT MODULE (Razorpay). Runs with the MOCK gateway by default — no keys
#  needed. Set PAYMENT_PROVIDER=razorpay + the RAZORPAY_* keys to go live.
# ============================================================================
PAYMENTS_ENABLED=true
PAYMENT_WEBHOOK_ENABLED=true
PAYMENT_PROVIDER=mock            # mock | razorpay
PAYMENT_CURRENCY=INR
PAYMENT_TAX_PERCENT=0
PAYMENT_ORDER_EXPIRY_MIN=30
PAYMENT_MAX_ATTEMPTS=3
PAYMENT_BACKOFF_MS=1000

# Mock gateway signing secret (dev/test only; deterministic signatures).
PAYMENT_MOCK_SECRET=mock_secret_key

# Razorpay credentials (required only when PAYMENT_PROVIDER=razorpay).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Admin API token: reuses NOTIF_ADMIN_TOKEN; PAYMENT_ADMIN_TOKEN overrides.
PAYMENT_ADMIN_TOKEN=

# ============================================================================
#  GOOGLE OAUTH 2.0 (additive). Runs in MOCK mode with no credentials so the
#  flow + tests work offline. Set GOOGLE_CLIENT_ID to activate real Google
#  ID-token verification (requires `npm i google-auth-library`).
# ============================================================================
OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Additive session token (JWT-like HS256). REQUIRED in production.
JWT_SECRET=
AUTH_TOKEN_TTL_SEC=604800

# Mock Google verifier secret (dev/test only).
OAUTH_MOCK_SECRET=oauth_mock_secret

# Auto-link a Google login to an existing local account when Google asserts the
# email is verified (prevents duplicate accounts). Set false to require manual linking.
OAUTH_AUTOLINK=true
OAUTH_NONCE_TTL_SEC=600

# NOTE: the frontend "Continue with Google" button fetches the PUBLIC client id
# at runtime from GET /api/auth/google/config (single source of truth = server
# GOOGLE_CLIENT_ID above), so no separate VITE_GOOGLE_CLIENT_ID is required.
#
# GOOGLE_CLIENT_SECRET / GOOGLE_CALLBACK_URL below are reserved for a future
# server-side authorization-code flow; the current ID-token flow does not use them.

# ============================================================================
#  AUTH HARDENING (passwords, JWT access/refresh, lockout, RBAC, recovery)
# ============================================================================
# Admin access: these emails are granted the ADMIN role server-side on
# login/register (the secure replacement for the old client-side bypass). Use a
# comma-separated list; ADMIN_EMAIL (a single value, also used for booking
# alerts) is included automatically.
ADMIN_EMAILS=

# Feature flags
AUTH_ENABLED=true
GOOGLE_AUTH_ENABLED=true
EMAIL_VERIFICATION_ENABLED=true
PASSWORD_RESET_ENABLED=true
JWT_ENABLED=true
REFRESH_TOKEN_ENABLED=true

# Password hashing: scrypt (default, zero-dep) | argon2 | bcrypt (npm i to enable)
AUTH_PASSWORD_ALGO=scrypt
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true

# JWT access / refresh TTLs (seconds)
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# Account lockout (brute-force)
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MS=900000
AUTH_ATTEMPT_WINDOW_MS=900000

# Per-IP rate limiting
AUTH_RATE_WINDOW_MS=60000
AUTH_RATE_MAX_LOGIN=10
AUTH_RATE_MAX_SENSITIVE=5

# Reset / verification token TTLs (seconds) + link base URL.
# APP_BASE_URL is the FRONTEND origin only — bare origin, no path, no trailing
# "/" or "#". The server appends the HashRouter fragment itself, e.g.
# http://localhost:5173/#/reset-password?email=…&token=… .
# Never put "#" in the value: dotenv truncates unquoted values at "#".
RESET_TOKEN_TTL_SEC=1800
VERIFY_TOKEN_TTL_SEC=86400
APP_BASE_URL=http://localhost:5173
